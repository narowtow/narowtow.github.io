{
  "name": "narowtow-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build:data": "node scripts/build-data.mjs",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "test:unit": "playwright test --config tests/unit/playwright.config.ts --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "budget": "node scripts/check-budget.mjs",
    "audit": "lhci autorun",
    "verify": "bash scripts/check.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "d3-geo": "3.1.1",
    "html-validate": "11.17.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "world-atlas": "2.0.2"
  }
}
