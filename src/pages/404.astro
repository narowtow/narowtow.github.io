---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Justin Ho"
  description="This page could not be found. Explore Justin Ho’s data projects or return to the home page."
>
  <section class="not-found">
    <p class="kicker">404 · A missing observation</p>
    <h1>This page isn’t here.</h1>
    <p>The address may have changed. There’s still plenty to explore.</p>
    <div class="hero-actions">
      <a class="button primary" href="/">
        Go home <span aria-hidden="true">→</span>
      </a>
      <a class="button" href="/#projects">
        Explore projects
      </a>
    </div>
  </section>
</BaseLayout>
