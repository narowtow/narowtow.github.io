---
import type { CollectionEntry } from "astro:content";
interface Props {
  project: CollectionEntry<"projects">;
  caseStudy?: boolean;
}
const { project, caseStudy = false } = Astro.props;
const { links } = project.data;
const demoNoteId = `demo-note-${project.id}`;
---

<div class="project-links">
  {caseStudy && (
    <a class="strong-link" href={`/projects/${project.id}/`}>
      Read case study <span aria-hidden="true">→</span>
    </a>
  )}
  <a
    href={links.demo}
    aria-describedby={links.demoNote ? demoNoteId : undefined}
  >
    Live demo <span aria-hidden="true">↗</span>
  </a>
  <a href={links.repo}>
    Code <span aria-hidden="true">↗</span>
  </a>
  {!caseStudy && links.docs && (
    <a href={links.docs}>
      Methods doc <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
{links.demoNote && (
  <p class="demo-note" id={demoNoteId}>
    Live demo: {links.demoNote}
  </p>
)}
