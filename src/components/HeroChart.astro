---
import map from "../data/hero-map.json";
export interface Props {
  /** Accessible heading id the figure is labelled by (rendered by the parent). */
  labelledBy?: string;
  class?: string;
}
const { labelledBy, class: className } = Astro.props;
const bin = (value: number, boundaries: (number | null)[]) =>
  boundaries.slice(1, -1).filter((n) => value >= n!).length;
const caption =
  "Gradient boosting beat the better simple rule at most sites: median skill 10.7%; 191 of 200 sites’ 95% intervals are above zero (held-out 2024–2025).";
const ordered = map.sites
  .map((site, index) => ({ site, index }))
  .sort((a, b) => Number(a.site.ciLow <= 0) - Number(b.site.ciLow <= 0));
---

<figure
  class:list={["hero-chart", className]}
  aria-labelledby={labelledBy}
  data-hero-chart
  data-mode="skill"
>
  <div class="chart-toolbar">
    <span class="chart-eyebrow">200 sites · held-out 2024–2025</span>
    <div
      class="chart-toggle"
      role="group"
      aria-label="Map colour metric"
      hidden
    >
      <button type="button" data-mode="skill" aria-pressed="true">
        Skill
      </button>
      <button type="button" data-mode="error" aria-pressed="false">
        Error (°C)
      </button>
    </div>
  </div>
  <svg
    class="chart-plot"
    viewBox={`0 0 ${map.width} ${map.height}`}
    width={map.width}
    height={map.height}
    role="img"
    aria-label="Equal Earth map of 200 forecast sites. Median skill is 10.7% versus the better simple baseline; 191 sites have 95% intervals above zero. Use arrow keys to explore sites when JavaScript is enabled."
  >
    <path class="chart-land" d={map.landPath}></path>
    <g aria-hidden="true">
      {ordered.map(({ site: s, index }) => (
        <circle
          class="site"
          cx={s.x}
          cy={s.y}
          r="3.5"
          data-site={index}
          data-skill-bin={bin(s.skill, map.skillBins)}
          data-error-bin={bin(s.maeModel, map.errorBins)}
          data-uncertain={s.ciLow <= 0 && s.ciHigh >= 0 ? "true" : "false"}
        />
      ))}
    </g>
  </svg>
  <div class="chart-legend" role="group" aria-label="Map legend">
    <div class="legend-scale">
      <span class="legend-title" data-legend-title>
        Skill vs better baseline
      </span>
      <div class="legend-swatches" aria-hidden="true">
        {Array.from({ length: 7 }, (_, i) => (
          <span data-bin={i}></span>
        ))}
      </div>
      <div class="legend-ticks" data-legend-ticks>
        <span>&lt; 0%</span>
        <span>0</span>
        <span>10%</span>
        <span>20%+</span>
      </div>
    </div>
    <span class="ring-key">
      <span aria-hidden="true"></span>95% CI includes 0
    </span>
  </div>
  <p
    class="chart-readout"
    data-readout
    aria-live="polite"
    aria-atomic="true"
    tabindex="0"
  >
    Hover, tap or use arrow keys to inspect a site.
  </p>
  <script
    type="application/json"
    data-chart-sites
    set:html={JSON.stringify(map.sites).replace(/</g, "\\u003c")}
  />
  <figcaption>
    <p class="chart-caption" data-caption>
      {caption}
    </p>
    <details class="chart-summary">
      <summary>How to read this map · data</summary>
      <p class="chart-method">
        Skill = 1 − MAE_model / MAE_baseline. The better rule is selected per
        site on 2022–2023 validation years. Rings mark intervals that include
        zero.
      </p>
      <div class="chart-table-wrap">
        <table>
          <caption>
            Per-site gradient boosting, 2024–2025 test years; medians of
            site-level skills versus the validation-selected better baseline.
          </caption>
          <thead>
            <tr>
              <th scope="col">Köppen group</th>
              <th scope="col">Sites</th>
              <th scope="col">Median skill</th>
              <th scope="col">95% CI above 0</th>
            </tr>
          </thead>
          <tbody>
            {map.groups.map((g) => (
              <tr>
                <th scope="row">
                  {g.group} {g.label}
                </th>
                <td>{g.n}</td>
                <td>{(g.medianSkill * 100).toFixed(1)}%</td>
                <td>{g.nCiAboveZero}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Skillmap analysis of ERA5 (Copernicus/ECMWF) via Open-Meteo; places from
        GeoNames; Köppen classes from Beck et al. (2023). Land: Natural Earth,
        public domain. This sample describes climate-stratified sites, not a
        global area-weighted average.
      </p>
    </details>
  </figcaption>
</figure>
<script>
  import "../scripts/hero-chart";
</script>
<style>
  .hero-chart {
    margin: 0;
    color: var(--color-ink);
  }
  .chart-toolbar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    min-height: 52px;
  }
  .chart-eyebrow,
  .chart-legend {
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .chart-eyebrow {
    color: var(--color-muted);
    font-size: clamp(0.6rem, 1.5vw, 0.72rem);
    white-space: nowrap;
  }
  .chart-toggle {
    flex-shrink: 0;
    display: flex;
    border: 1px solid var(--color-rule);
    border-radius: 2rem;
    padding: 3px;
  }
  .chart-toggle[hidden] {
    display: none;
  }
  button {
    min-height: 44px;
    padding: 0.4rem 0.65rem;
    border: 0;
    border-radius: 2rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--color-muted);
    background: transparent;
    cursor: pointer;
  }
  button[aria-pressed="true"] {
    color: var(--color-bg);
    background: var(--color-ink);
  }
  button:focus-visible,
  svg:focus-visible,
  .chart-readout:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  /* Override the desktop page cap while preserving the viewBox ratio. */
  .hero-chart svg.chart-plot {
    display: block;
    width: 100%;
    margin-inline: 0;
    height: auto;
    aspect-ratio: 960 / 482;
    padding: 0;
    overflow: visible;
    border-radius: 0.5rem;
  }
  .chart-land {
    fill: var(--color-data-land);
  }
  .site {
    --dot: var(--color-data-zero);
    fill: var(--dot);
    stroke: color-mix(in oklab, var(--dot), var(--color-ink) 60%);
    stroke-width: 0.75;
    vector-effect: non-scaling-stroke;
  }
  [data-mode="skill"] [data-skill-bin="0"],
  [data-mode="skill"] [data-bin="0"] {
    --dot: var(--color-data-neg);
  }
  [data-mode="skill"] [data-skill-bin="1"],
  [data-mode="skill"] [data-bin="1"] {
    --dot: var(--color-data-zero);
  }
  [data-mode="skill"] [data-skill-bin="2"],
  [data-mode="skill"] [data-bin="2"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos) 35%
    );
  }
  [data-mode="skill"] [data-skill-bin="3"],
  [data-mode="skill"] [data-bin="3"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos) 70%
    );
  }
  [data-mode="skill"] [data-skill-bin="4"],
  [data-mode="skill"] [data-bin="4"] {
    --dot: var(--color-data-pos);
  }
  [data-mode="skill"] [data-skill-bin="5"],
  [data-mode="skill"] [data-bin="5"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-pos),
      var(--color-data-pos-strong) 50%
    );
  }
  [data-mode="skill"] [data-skill-bin="6"],
  [data-mode="skill"] [data-bin="6"] {
    --dot: var(--color-data-pos-strong);
  }
  [data-mode="error"] [data-error-bin="0"],
  [data-mode="error"] [data-bin="0"] {
    --dot: var(--color-data-zero);
  }
  [data-mode="error"] [data-error-bin="1"],
  [data-mode="error"] [data-bin="1"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos-strong) 17%
    );
  }
  [data-mode="error"] [data-error-bin="2"],
  [data-mode="error"] [data-bin="2"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos-strong) 33%
    );
  }
  [data-mode="error"] [data-error-bin="3"],
  [data-mode="error"] [data-bin="3"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos-strong) 50%
    );
  }
  [data-mode="error"] [data-error-bin="4"],
  [data-mode="error"] [data-bin="4"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos-strong) 67%
    );
  }
  [data-mode="error"] [data-error-bin="5"],
  [data-mode="error"] [data-bin="5"] {
    --dot: color-mix(
      in oklab,
      var(--color-data-zero),
      var(--color-data-pos-strong) 83%
    );
  }
  [data-mode="error"] [data-error-bin="6"],
  [data-mode="error"] [data-bin="6"] {
    --dot: var(--color-data-pos-strong);
  }
  .site[data-uncertain="true"] {
    fill: none;
    stroke: color-mix(in oklab, var(--dot), var(--color-ink) 60%);
    stroke-width: 1.7;
  }
  .site[data-current="true"] {
    stroke: var(--color-ink);
    stroke-width: 2.5;
  }
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1rem;
    margin: 0.65rem 0;
  }
  .legend-scale {
    flex: 1 1 13rem;
    max-width: 23rem;
    min-width: 0;
    padding-inline: 0.5rem;
  }
  .legend-title {
    display: block;
    margin-bottom: 0.5rem;
  }
  .legend-swatches {
    display: flex;
    gap: 2px;
    height: 9px;
  }
  .legend-swatches span {
    flex: 1;
    background: var(--dot);
  }
  .legend-ticks {
    display: flex;
    justify-content: space-between;
    margin-top: 0.4rem;
  }
  .ring-key {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ring-key > span {
    width: 9px;
    height: 9px;
    border: 2px solid var(--color-data-pos);
    border-radius: 50%;
  }
  .chart-readout {
    /* Reserve two lines; long site details scroll without moving the caption. */
    min-height: 2lh;
    height: 2lh;
    overflow-y: auto;
    padding: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
    margin: 0.65rem 0;
  }
  .chart-caption {
    margin: 0;
    font-family: var(--font-sans);
    letter-spacing: normal;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .chart-method,
  .chart-summary {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .chart-method {
    margin: 0.5rem 0;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
    display: list-item;
    padding: 0.75rem 0;
  }
  .chart-table-wrap {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.75rem;
  }
  caption {
    text-align: left;
    padding-bottom: 0.5rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.5rem;
    border-bottom: 1px solid var(--color-rule);
  }
  @media (min-width: 1060px) {
    .hero-chart svg.chart-plot {
      max-width: 580px;
    }
  }
  @media (max-width: 600px) {
    .site {
      r: 10px;
    }
  }
  @media (max-width: 359px) {
    .chart-toolbar {
      flex-wrap: wrap;
    }
  }
  @media (max-width: 400px) {
    .site {
      r: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none;
      animation: none;
    }
  }
</style>
